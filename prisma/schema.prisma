generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  role        Role      @default(STUDENT)
  avatarUrl   String?
  dateOfBirth DateTime?
  phone       String?
  gender      Gender?
  state       String?
  lga         String?
  address     String?
  isActive    Boolean   @default(true)

  /// Whether this person may be messaged, per channel.
  ///
  /// Default true, because every existing account was created on the understanding that
  /// the school may contact them, and defaulting to false would silently mute a whole
  /// school the day notifications ship. Turning one off is a deliberate act by the person
  /// or by an administrator, and `resolveRecipients` refuses a muted channel outright
  /// rather than queueing a message nobody will look at.
  notifyBySms   Boolean @default(true)
  notifyByEmail Boolean @default(true)

  credentials                Credential[]               @relation("UserCredentials")
  loginAttempts              LoginAttempt[]
  sessions                   LoginSession[]
  student                    Student?
  teacher                    Teacher?
  parent                     Parent?
  admin                      Admin?
  superAdmin                 SuperAdmin?
  assessmentsEdited          Assessment[]               @relation("AssessmentEditedByUser")
  assessmentsCreated         Assessment[]               @relation("AssessmentCreatedByUser")
  assessmentsUpdated         Assessment[]               @relation("AssessmentUpdatedByUser")
  createdTransitions         StudentTransition[]        @relation("CreatedByUser")
  enrollmentHistory          StudentEnrollmentHistory[] @relation("EnrollmentHistoryCreatedBy")
  traitRatingsRecorded       StudentTraitRating[]       @relation("TraitRatingRecordedBy")
  integrityChecks            DataIntegrityCheck[]       @relation("IntegrityChecksRunBy")
  accountingReversals        AccountingReversal[]       @relation("AccountingReversalCreatedBy")
  receivedPayments           Payment[]                  @relation("PaymentReceivedByUser")
  expensesRecorded           Expense[]                  @relation("ExpenseRecordedBy")
  expensesApproved           Expense[]                  @relation("ExpenseApprovedBy")
  expensesPaid               Expense[]                  @relation("ExpensePaidBy")
  expensesReceived           Expense[]                  @relation("ExpensePayeeUser")
  expenseAttachments         ExpenseAttachment[]        @relation("ExpenseAttachmentUploadedBy")
  staffRecord                Staff?
  payrollsGenerated          PayrollRun[]               @relation("PayrollGeneratedBy")
  payrollsApproved           PayrollRun[]               @relation("PayrollApprovedBy")
  payrollsPaid               PayrollRun[]               @relation("PayrollPaidBy")
  salaryPaymentsMade         SalaryPayment[]            @relation("SalaryPaidBy")
  salariesCreated            StaffSalary[]              @relation("StaffSalaryCreatedBy")
  salariesApproved           StaffSalary[]              @relation("StaffSalaryApprovedBy")
  disciplineRecorded         StaffDisciplinaryRecord[]  @relation("DisciplineRecordedBy")
  disciplineApproved         StaffDisciplinaryRecord[]  @relation("DisciplineApprovedBy")
  permissionProfiles         UserPermissionProfile[]    @relation("UserPermissionProfiles")
  permissionProfilesAssigned UserPermissionProfile[]    @relation("PermissionProfilesAssignedBy")
  resultWorkflowEvents       ResultWorkflowEvent[]      @relation("ResultWorkflowEventActor")
  attendancesMarked          Attendance[]               @relation("AttendanceMarkedBy")
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@index([role, isActive])
  @@index([gender])
  @@index([state])
  @@index([createdAt, role])
  @@map("users")
}

model Student {
  id          String   @id @default(uuid())
  userId      String   @unique
  schoolId    String
  admissionNo String   @unique
  year        Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parents                  StudentParent[]                   @relation("StudentParents")
  classTerms               StudentClassTerm[]                @relation("StudentClassTerms")
  assessments              Assessment[]                      @relation("StudentAssessments")
  payments                 Payment[]                         @relation("StudentPayments")
  gatewayTransactions      GatewayTransaction[]
  charges                  StudentCharge[]                   @relation("StudentCharges")
  discounts                Discount[]                        @relation("StudentDiscounts")
  exemptions               FeeExemption[]                    @relation("StudentFeeExemptions")
  expensesReceived         Expense[]                         @relation("ExpensePayeeStudent")
  transitions              StudentTransition[]               @relation("StudentTransitions")
  attendances              Attendance[]                      @relation("StudentAttendances")
  enrollmentHistory        StudentEnrollmentHistory[]        @relation("StudentEnrollmentHistory")
  traitRatings             StudentTraitRating[]              @relation("StudentTraitRatings")
  annualDecisions          AnnualResultDecision[]
  dedicatedAccounts        DedicatedAccount[]
  unappliedPayments        UnappliedPayment[]
  dedicatedIdentifications DedicatedCustomerIdentification[]

  @@index([schoolId])
  @@index([admissionNo])
  @@index([year])
  @@index([createdAt])
  @@map("students")
}

model Assessment {
  id                 String  @id @default(uuid())
  studentId          String
  subjectId          String
  termId             String
  studentClassTermId String
  teacherId          String?

  // Scores
  ca1  Float?
  ca2  Float?
  ca3  Float?
  exam Float?

  // Derived fields
  grade  String?
  remark String?

  // Status Flags
  isAbsent    Boolean @default(false)
  isExempt    Boolean @default(false)
  isPublished Boolean @default(false)

  editedBy     String
  editedByUser User   @relation("AssessmentEditedByUser", fields: [editedBy], references: [id])

  createdBy     String
  createdByUser User    @relation("AssessmentCreatedByUser", fields: [createdBy], references: [id])
  updatedBy     String?
  updatedByUser User?   @relation("AssessmentUpdatedByUser", fields: [updatedBy], references: [id])

  // Release provenance. `isPublished` alone said nothing about who released a set of
  // results or when, and there was no way to walk one back.
  publishedAt DateTime?
  /// User id, deliberately without a relation — this is a record of who released results,
  /// and it should survive that user being deleted.
  publishedBy String?

  // What used to sit here: `version`, `previousVersionId`, `isDraft` and `submittedAt`,
  // under a "Version control" comment. All four were declared and never read or written
  // anywhere, so they promised a revision history that did not exist. The need they
  // described is now genuinely met by AuditLog, which records every score save with its
  // actor and before/after state, so the columns are gone rather than half-implemented.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student          Student          @relation("StudentAssessments", fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term             Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentClassTerm StudentClassTerm @relation(fields: [studentClassTermId], references: [id], onDelete: Cascade)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  // One score row per student, per subject, per term — full stop. `teacherId` used to be
  // part of this key, which let the two save paths each create their own row for the same
  // student and subject. It is now a plain attribute recording who entered the score.
  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([studentClassTermId])
  @@index([teacherId])
  @@index([termId, subjectId, isPublished])
  @@index([publishedAt])
  @@index([studentClassTermId, subjectId])
  @@index([createdAt, editedBy])
  @@map("assessments")
}

model StudentEnrollmentHistory {
  id                  String           @id @default(uuid())
  studentId           String
  classTermId         String
  termId              String
  action              EnrollmentAction
  previousClassTermId String?
  reason              String?
  createdBy           String
  createdAt           DateTime         @default(now())

  student       Student   @relation("StudentEnrollmentHistory", fields: [studentId], references: [id], onDelete: Restrict)
  classTerm     ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Restrict)
  term          Term      @relation(fields: [termId], references: [id], onDelete: Restrict)
  createdByUser User      @relation("EnrollmentHistoryCreatedBy", fields: [createdBy], references: [id])

  @@index([studentId, termId])
  @@index([classTermId, action])
}

model StudentTransition {
  id              String         @id @default(uuid())
  studentId       String
  fromClassTermId String
  toClassTermId   String
  transitionType  TransitionType
  transitionDate  DateTime       @default(now())
  notes           String?
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  student       Student   @relation("StudentTransitions", fields: [studentId], references: [id], onDelete: Cascade)
  fromClassTerm ClassTerm @relation("FromClassTerm", fields: [fromClassTermId], references: [id], onDelete: Cascade)
  toClassTerm   ClassTerm @relation("ToClassTerm", fields: [toClassTermId], references: [id], onDelete: Cascade)
  createdByUser User      @relation("CreatedByUser", fields: [createdBy], references: [id])

  @@index([studentId])
  @@index([fromClassTermId])
  @@index([toClassTermId])
  @@index([transitionDate])
  @@index([transitionType])
}

model GradingSystem {
  id          String       @id @default(uuid())
  schoolId    String
  name        String       @default("WAEC Standard")
  description String?
  isDefault   Boolean      @default(false)
  passMark    Float        @default(40)
  levels      GradeLevel[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// How a school splits a subject's marks between continuous assessment and the exam.
///
/// This existed only as literals in the source — `validateScore(assessment.ca1, "CA1", 10)`
/// in three separate files — which fixed every school on CA 10/10/10 plus a 70-mark exam.
/// A school on 40/60, or with two CAs, or with a practical component, could not be
/// onboarded without a code change.
///
/// The `Assessment` table has four fixed score columns, so a scheme configures the maximum
/// for each rather than allowing arbitrary components. A maximum of 0 means that slot is
/// unused, which is how a two-CA school is expressed.
model AssessmentScheme {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  name      String   @default("Three CAs and an exam")
  ca1Max    Int      @default(10)
  ca2Max    Int      @default(10)
  ca3Max    Int      @default(10)
  examMax   Int      @default(70)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// One workflow row per class term result set. It gives a school a visible lifecycle:
/// draft, reviewed, published, locked, or withdrawn. Individual Assessment rows still
/// carry publication flags for family visibility; this row is the module-level state.
model ClassTermResultWorkflow {
  id                       String               @id @default(uuid())
  classTermId              String               @unique
  status                   ResultWorkflowStatus @default(DRAFT)
  reviewedBy               String?
  reviewedAt               DateTime?
  publishedBy              String?
  publishedAt              DateTime?
  lockedBy                 String?
  lockedAt                 DateTime?
  withdrawnBy              String?
  withdrawnAt              DateTime?
  notes                    String?              @db.VarChar(1000)
  /// Frozen policies used when the result was published. Historical reports must never
  /// change because a school edits its current grading bands or assessment split.
  gradingSnapshot          Json?
  assessmentSchemeSnapshot Json?
  snapshotCapturedAt       DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  classTerm ClassTerm             @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  events    ResultWorkflowEvent[]

  @@index([status, updatedAt])
}

model ResultWorkflowEvent {
  id         String                @id @default(uuid())
  workflowId String
  action     String
  fromStatus ResultWorkflowStatus?
  toStatus   ResultWorkflowStatus
  actorId    String
  actorName  String
  actorRole  Role
  note       String?               @db.VarChar(1000)
  createdAt  DateTime              @default(now())

  workflow ClassTermResultWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor    User                    @relation("ResultWorkflowEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workflowId, createdAt])
  @@index([actorId, createdAt])
}

model GradeLevel {
  id              String   @id @default(uuid())
  gradingSystemId String
  minScore        Float
  maxScore        Float
  grade           String
  remark          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gradingSystem GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@unique([gradingSystemId, grade])
}

model Payment {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String
  feeStructureId String?
  termId         String
  sessionId      String?
  // Money is Decimal, never Float. Two decimal places is kobo; 12 digits of precision
  // carries a term's fees for a large school without approaching the limit.
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime
  receiptNo      String
  paymentMethod  String
  referenceNo    String?
  receivedBy     String?
  notes          String?       @db.Text
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student              @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure       FeeStructure?        @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  term               Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)
  session            Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  receivedByUser     User?                @relation("PaymentReceivedByUser", fields: [receivedBy], references: [id], onDelete: SetNull)
  allocations        PaymentAllocation[]
  reversals          AccountingReversal[]
  gatewayTransaction GatewayTransaction?
  gatewayRefunds     GatewayRefund[]

  // Receipt numbers are issued per school, so two schools may both hold receipt 0001.
  unappliedApplications UnappliedPayment[]

  @@unique([schoolId, receiptNo])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([sessionId, status])
  @@index([receivedBy])
  @@index([schoolId, status])
  @@index([termId, status])
  @@index([paymentDate])
}

/// Per-school, per-year receipt counter. Mirrors AdmissionSequence, whose atomic
/// increment-on-upsert is already proven race-safe under concurrent registration.
model ReceiptSequence {
  id           String   @id @default(uuid())
  schoolId     String
  year         Int
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
  @@index([schoolId, year])
}

model Credential {
  id           String         @id @default(uuid())
  userId       String
  type         CredentialType
  value        String         @unique
  passwordHash String
  isPrimary    Boolean        @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user          User           @relation("UserCredentials", fields: [userId], references: [id], onDelete: Cascade)
  loginAttempts LoginAttempt[]
  sessions      LoginSession[]

  @@unique([userId, type])
  @@index([type, value])
}

model LoginAttempt {
  id                String        @id @default(uuid())
  credentialId      String?
  userId            String
  ipAddress         String
  userAgent         String?
  deviceFingerprint String?
  status            AttemptStatus
  attemptTime       DateTime      @default(now())
  metadata          Json?

  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginSession {
  id           String    @id @default(uuid())
  userId       String
  credentialId String?
  ipAddress    String
  userAgent    String?
  deviceId     String?
  sessionToken String
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActivity DateTime?
  sessionData  Json?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model School {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  address  String
  phone    String
  email    String
  website  String?
  logoUrl  String?
  isActive Boolean @default(true)

  admissionPrefix        String @default("STD")
  admissionFormat        String @default("{PREFIX}-{YEAR}-{NUMBER}")
  admissionSequenceStart Int    @default(1)

  sessions                    Session[]
  classes                     Class[]
  subjects                    Subject[]
  students                    Student[]
  teachers                    Teacher[]
  parents                     Parent[]
  admins                      Admin[]
  gradingSystems              GradingSystem[]
  admissionSequences          AdmissionSequence[]
  systemConfigurations        SystemConfiguration[]
  feeStructures               FeeStructure[]
  feeCategories               FeeCategory[]
  feeSchedules                FeeSchedule[]
  studentCharges              StudentCharge[]
  discounts                   Discount[]
  feeExemptions               FeeExemption[]
  payments                    Payment[]
  receiptSequences            ReceiptSequence[]
  expenseCategories           ExpenseCategory[]
  paymentAccounts             PaymentAccount[]
  expenses                    Expense[]
  voucherSequences            ExpenseVoucherSequence[]
  staff                       Staff[]
  staffConfig                 StaffConfig?
  salaryScales                SalaryScale[]
  allowanceTypes              AllowanceType[]
  deductionTypes              DeductionType[]
  payrollRuns                 PayrollRun[]
  payrollItems                PayrollItem[]
  salaryPayments              SalaryPayment[]
  payslipSequences            PayslipSequence[]
  transitionPolicy            TransitionPolicy?
  classPromotionPolicies      ClassPromotionPolicy[]
  annualDecisions             AnnualResultDecision[]
  notifications               NotificationOutbox[]
  notificationTemplates       NotificationTemplate[]
  assessmentScheme            AssessmentScheme?
  permissionProfiles          PermissionProfile[]
  traitRatings                StudentTraitRating[]
  academicPeriod              SchoolAcademicPeriod?
  accountingReversals         AccountingReversal[]
  integrityChecks             DataIntegrityCheck[]
  paymentConfigurations       SchoolPaymentConfiguration[]
  gatewayTransactions         GatewayTransaction[]
  gatewayEvents               GatewayEvent[]
  gatewayRefunds              GatewayRefund[]
  gatewayDisputes             GatewayDispute[]
  gatewaySettlements          GatewaySettlement[]
  gatewayReconciliationIssues GatewayReconciliationIssue[]

  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  dedicatedAccounts        DedicatedAccount[]
  unappliedPayments        UnappliedPayment[]
  dedicatedIdentifications DedicatedCustomerIdentification[]
  announcements            Announcement[]
  notificationSettings     SchoolNotificationSettings?
}

model AdmissionSequence {
  id           String   @id @default(uuid())
  schoolId     String
  year         Int
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
  @@index([schoolId, year])
}

model Session {
  id                String                 @id @default(uuid())
  schoolId          String
  name              String
  startDate         DateTime
  endDate           DateTime
  isCurrent         Boolean                @default(false)
  terms             Term[]
  payments          Payment[]
  feeSchedules      FeeSchedule[]
  studentCharges    StudentCharge[]
  discounts         Discount[]
  feeExemptions     FeeExemption[]
  expenses          Expense[]
  payrollRuns       PayrollRun[]
  currentForSchools SchoolAcademicPeriod[] @relation("CurrentAcademicSession")
  annualDecisions   AnnualResultDecision[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Term {
  id        String   @id @default(uuid())
  sessionId String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session             Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classTerms          ClassTerm[]
  assessments         Assessment[]
  attendances         Attendance[]
  payments            Payment[]
  feeSchedules        FeeSchedule[]
  studentCharges      StudentCharge[]
  discounts           Discount[]
  feeExemptions       FeeExemption[]
  studentClassTerms   StudentClassTerm[]
  teacherSubjects     TeacherSubject[] // Added relationship
  enrollmentHistory   StudentEnrollmentHistory[]
  expenses            Expense[]
  traitRatings        StudentTraitRating[]
  currentForSchools   SchoolAcademicPeriod[]     @relation("CurrentAcademicTerm")
  gatewayTransactions GatewayTransaction[]

  @@index([isCurrent])
}

/// The database-enforced current-period pointer. There can be exactly one row per school;
/// the legacy Boolean flags remain synchronized for existing queries and UI code.
model SchoolAcademicPeriod {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  sessionId String
  termId    String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session Session @relation("CurrentAcademicSession", fields: [sessionId], references: [id], onDelete: Cascade)
  term    Term    @relation("CurrentAcademicTerm", fields: [termId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([termId])
}

model Class {
  id        String     @id @default(uuid())
  schoolId  String
  name      String
  level     ClassLevel
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTerms      ClassTerm[]
  subjects        ClassSubject[]
  promotionPolicy ClassPromotionPolicy?
  annualDecisions AnnualResultDecision[]
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]
  assessments     Assessment[]
}

model ClassTerm {
  id        String   @id @default(uuid())
  classId   String
  termId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class             Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  term              Term                       @relation(fields: [termId], references: [id], onDelete: Cascade)
  students          StudentClassTerm[]
  teachers          TeacherClassTerm[]
  classSubjects     ClassSubject[]
  fromTransitions   StudentTransition[]        @relation("FromClassTerm")
  toTransitions     StudentTransition[]        @relation("ToClassTerm")
  enrollmentHistory StudentEnrollmentHistory[]
  feeStructures     FeeStructure[]
  feeSchedules      FeeSchedule[]
  studentCharges    StudentCharge[]
  resultWorkflow    ClassTermResultWorkflow?
  traitRatings      StudentTraitRating[]
  attendances       Attendance[]

  @@unique([classId, termId])
}

/// School-defined permission profile such as Manager, Exams Officer, Accountant,
/// Payroll Officer, or read-only auditor. Login roles remain broad account categories;
/// these profiles define what the person may actually do inside the school.
model PermissionProfile {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  code        String
  description String?  @db.VarChar(500)
  permissions Json
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments UserPermissionProfile[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
}

/// Assigns a permission profile to a user inside a school. A user may hold more than one
/// profile: for example, an exams officer who can also view finance reports.
model UserPermissionProfile {
  id         String    @id @default(uuid())
  userId     String
  schoolId   String
  profileId  String
  assignedBy String?
  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  user           User              @relation("UserPermissionProfiles", fields: [userId], references: [id], onDelete: Cascade)
  profile        PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedByUser User?             @relation("PermissionProfilesAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, schoolId, profileId])
  @@index([schoolId, isActive])
  @@index([profileId, isActive])
}

model ClassSubject {
  id          String   @id @default(uuid())
  classId     String
  subjectId   String
  classTermId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classTerm ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, classTermId])
}

model StudentClassTerm {
  id          String           @id @default(uuid())
  studentId   String
  classTermId String
  termId      String
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student     Student      @relation("StudentClassTerms", fields: [studentId], references: [id], onDelete: Cascade)
  classTerm   ClassTerm    @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  term        Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@unique([studentId, classTermId])
  @@unique([studentId, termId, status])
  @@index([classTermId, status])
  @@index([termId, status])
  @@map("student_class_terms")
}

model SystemConfiguration {
  id          String   @id @default(uuid())
  schoolId    String?
  configKey   String
  /// Text, not the default VARCHAR(191): settings hold things like a JSON status payload
  /// or a file path, and 191 characters silently was not enough.
  configValue String   @db.Text
  configType  String   @default("STRING")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, configKey])
  @@index([configKey, isActive])
}

/// Append-only record of who changed what.
///
/// `LoginAttempt` and `LoginSession` cover authentication thoroughly; nothing covered the
/// business actions — who edited a score, promoted a cohort, moved a grading band. The
/// Assessment table keeps only last-writer columns, so a disputed grade had no history.
///
/// Deliberately has **no foreign keys**. An audit row must survive the deletion of the user
/// who caused it and the school it happened in, so the actor's name and role are copied in
/// rather than joined. Never update or delete rows in this table.
model AuditLog {
  id         String   @id @default(uuid())
  /// Null for a platform-level action by a super admin.
  schoolId   String?
  actorId    String
  actorName  String
  actorRole  Role
  /// Dotted verb, e.g. "assessment.save", "student.promote", "term.set_current".
  action     String
  entityType String
  entityId   String?
  /// One human-readable line: what happened, in the words a head teacher would use.
  summary    String   @db.VarChar(500)
  /// Prior and resulting state for the fields that changed. Keep these small — they are
  /// for answering "what did this look like before", not a full row copy.
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model DataIntegrityCheck {
  id          String      @id @default(uuid())
  schoolId    String?
  checkType   String
  description String
  status      CheckStatus @default(PENDING)
  issuesFound Int         @default(0)
  results     Json?
  completedAt DateTime?
  resolvedAt  DateTime?
  runBy       String
  createdAt   DateTime    @default(now())

  school    School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  runByUser User    @relation("IntegrityChecksRunBy", fields: [runBy], references: [id], onDelete: Restrict)

  @@index([schoolId, checkType, status])
  @@index([createdAt])
}

model StudentParent {
  id           String   @id @default(uuid())
  studentId    String
  parentId     String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation("StudentParents", fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model Teacher {
  id            String   @id @default(uuid())
  userId        String   @unique
  schoolId      String
  staffId       String
  department    String?
  qualification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherClassTerms TeacherClassTerm[]
  teacherSubjects   TeacherSubject[]
  assessments       Assessment[]

  @@unique([userId, schoolId])
  @@unique([staffId, schoolId])
  @@index([schoolId])
}

model TeacherClassTerm {
  id          String   @id @default(uuid())
  teacherId   String
  classTermId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classTerm ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classTermId])
  @@index([teacherId])
  @@index([classTermId])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  termId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, termId])
  @@index([teacherId, termId])
  @@index([termId])
}

model Parent {
  id         String   @id @default(uuid())
  userId     String   @unique
  schoolId   String
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentParent[]

  @@unique([userId, schoolId])
}

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique
  schoolId    String?
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SuperAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeeStructure {
  id          String   @id @default(uuid())
  schoolId    String
  // Keyed on ClassTerm, like every other flow in the app. A fee can no longer be defined
  // for a class/term pair that was never actually instantiated as a class term.
  classTermId String
  name        String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTerm ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([classTermId, name])
  @@index([schoolId])
  @@index([classTermId])
  @@index([schoolId, isActive])
}

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  description String?
  type        FeeType  @default(MANDATORY)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeSchedules FeeSchedule[]
  discounts    Discount[]
  exemptions   FeeExemption[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@index([type])
}

model FeeSchedule {
  id          String       @id @default(uuid())
  schoolId    String
  sessionId   String
  termId      String?
  classTermId String?
  categoryId  String
  name        String
  description String?
  amount      Decimal      @db.Decimal(12, 2)
  appliesTo   FeeAppliesTo @default(ALL_STUDENTS)
  isMandatory Boolean      @default(true)
  isActive    Boolean      @default(true)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term       Term?           @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTerm  ClassTerm?      @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  category   FeeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  charges    StudentCharge[]
  discounts  Discount[]
  exemptions FeeExemption[]

  // Prefix-indexed on the ids: six full VARCHAR(191) columns is 4584 bytes of utf8mb4,
  // past InnoDB's 3072-byte key limit. The ids are uuid(), so 36 characters is the whole
  // value and uniqueness is unchanged; only `name` is compared in full.
  // Named explicitly because the generated name would exceed MySQL's 64-char limit.
  @@unique([schoolId(length: 36), sessionId(length: 36), termId(length: 36), classTermId(length: 36), categoryId(length: 36), name], map: "FeeSchedule_scope_name_key")
  @@index([schoolId, isActive])
  @@index([sessionId])
  @@index([termId])
  @@index([classTermId])
  @@index([categoryId])
  @@index([appliesTo])
}

model StudentCharge {
  id             String       @id @default(uuid())
  schoolId       String
  studentId      String
  sessionId      String
  termId         String?
  classTermId    String?
  feeScheduleId  String
  originalAmount Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  exemptedAmount Decimal      @default(0) @db.Decimal(12, 2)
  finalAmountDue Decimal      @db.Decimal(12, 2)
  amountPaid     Decimal      @default(0) @db.Decimal(12, 2)
  balance        Decimal      @db.Decimal(12, 2)
  status         ChargeStatus @default(UNPAID)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school             School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student                        @relation("StudentCharges", fields: [studentId], references: [id], onDelete: Cascade)
  session            Session                        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term               Term?                          @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTerm          ClassTerm?                     @relation(fields: [classTermId], references: [id], onDelete: SetNull)
  feeSchedule        FeeSchedule                    @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  allocations        PaymentAllocation[]
  gatewayAllocations GatewayTransactionAllocation[]
  discounts          Discount[]
  exemptions         FeeExemption[]

  @@unique([studentId, feeScheduleId])
  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([sessionId, status])
  @@index([termId, status])
  @@index([classTermId, status])
  @@index([feeScheduleId])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  chargeId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  StudentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}

/// Per-school payment-provider policy. A row is environment-specific so test onboarding
/// can be completed without accidentally enabling the live connection.
model SchoolPaymentConfiguration {
  id                              String                            @id @default(uuid())
  schoolId                        String
  provider                        PaymentGatewayProvider            @default(PAYSTACK)
  environment                     PaymentGatewayEnvironment
  accountMode                     PaymentGatewayAccountMode         @default(PLATFORM_MANAGED)
  status                          PaymentGatewayConfigurationStatus @default(DRAFT)
  isEnabled                       Boolean                           @default(false)
  subaccountCode                  String?
  providerAccountId               String?
  /// Reference to an encrypted secret or vault entry for a future school-owned connection.
  /// Never store an API secret directly in this field.
  credentialKeyRef                String?
  businessName                    String?
  settlementBankCode              String?
  settlementAccountLast4          String?                           @db.VarChar(4)
  // A school adopting online payment is not volunteering to lose 1.5% of its fees, so a
  // new configuration puts the processing fee on the payer. A school that would rather
  // absorb it says so; nothing changes for configurations that already chose.
  feePolicy                       PaymentGatewayFeePolicy           @default(PARENT_PAYS_GROSS_UP)
  platformChargeType              PaymentGatewayChargeType          @default(NONE)
  platformChargeValue             Decimal                           @default(0) @db.Decimal(12, 2)
  allowedChannels                 Json?
  allowPartialPayments            Boolean                           @default(false)
  allocationPolicy                GatewayAllocationPolicy           @default(SELECTED_CHARGES)
  configVersion                   Int                               @default(1)
  verifiedAt                      DateTime?
  suspendedAt                     DateTime?
  /// Slice 8 pilot gate. A school's own admin can switch LIVE on only after the platform
  /// owner has approved that school for live money; revoking the approval switches it off.
  liveApprovedAt                  DateTime?
  liveApprovedBy                  String?
  /// Optional ceiling on the school fees in one LIVE checkout while a school is piloting.
  pilotMaxAmount                  Decimal?                          @db.Decimal(14, 2)
  /// Slice 9: give each student a permanent Paystack account number to transfer fees to.
  dedicatedAccountsEnabled        Boolean                           @default(false)
  /// Paystack's bank slug for new accounts ("wema-bank", "titan-paystack"; "test-bank" in test).
  dedicatedAccountBank            String?                           @db.VarChar(64)
  /// Paystack split used by this school's dedicated accounts (DigiSchool-managed only): the
  /// school's subaccount bears Paystack's fee and DigiSchool keeps the platform percentage.
  dedicatedSplitCode              String?                           @db.VarChar(64)
  dedicatedSplitId                String?                           @db.VarChar(32)
  dedicatedSplitShare             Int?
  /// Set when Paystack requires customer identification (BVN) before assigning accounts.
  dedicatedRequiresIdentification Boolean                           @default(false)
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt

  school                   School                            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions             GatewayTransaction[]
  credential               PaymentGatewayCredential?
  dedicatedAccounts        DedicatedAccount[]
  dedicatedIdentifications DedicatedCustomerIdentification[]

  @@unique([schoolId, provider, environment])
  @@index([provider, environment, status])
  @@index([schoolId, isEnabled])
}

/// Encrypted school-owned provider credentials. The encryption key stays outside the
/// database; webhookToken selects the right secret without exposing a school id publicly.
model PaymentGatewayCredential {
  id                   String    @id @default(uuid())
  configurationId      String    @unique
  encryptedSecret      String    @db.Text
  initializationVector String    @db.VarChar(24)
  authenticationTag    String    @db.VarChar(32)
  secretLast4          String    @db.VarChar(4)
  publicKey            String?
  webhookToken         String    @unique @db.Char(64)
  keyVersion           Int       @default(1)
  rotatedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  configuration SchoolPaymentConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
}

/// Provider-side payment attempt. Successful rows link one-to-one to the ordinary
/// finance Payment so reports never need a second online-only ledger.
model GatewayTransaction {
  id                    String                    @id @default(uuid())
  schoolId              String
  studentId             String
  termId                String
  configurationId       String?
  provider              PaymentGatewayProvider    @default(PAYSTACK)
  environment           PaymentGatewayEnvironment
  reference             String
  providerTransactionId String?
  status                GatewayTransactionStatus  @default(CREATED)
  currency              String                    @default("NGN") @db.VarChar(3)
  amountExpected        Decimal                   @db.Decimal(14, 2)
  amountRequested       Decimal?                  @db.Decimal(14, 2)
  amountCharged         Decimal?                  @db.Decimal(14, 2)
  providerFee           Decimal?                  @db.Decimal(14, 2)
  channel               String?
  payerEmail            String?                   @db.VarChar(320)
  paymentId             String?                   @unique
  /// CHECKOUT is a parent-started Paystack checkout; DEDICATED_ACCOUNT is a transfer into a
  /// student's dedicated account, recorded when Paystack reports it.
  source                GatewayTransactionSource  @default(CHECKOUT)
  dedicatedAccountId    String?
  senderName            String?                   @db.VarChar(191)
  senderBank            String?                   @db.VarChar(120)
  configurationSnapshot Json?
  providerMetadata      Json?
  failureCode           String?
  failureMessage        String?                   @db.Text
  initializedAt         DateTime?
  verifiedAt            DateTime?
  paidAt                DateTime?
  expiresAt             DateTime?
  /// Durable verification recovery for the case where the provider webhook never reaches
  /// DigiSchool and the parent never returns to the callback page. The cron worker claims
  /// rows with these fields so overlapping runs cannot verify or post the same checkout.
  verificationAttempts  Int                       @default(0)
  verificationClaimedAt DateTime?
  nextVerificationAt    DateTime?
  lastVerificationError String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  school           School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student                        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term             Term                           @relation(fields: [termId], references: [id], onDelete: Restrict)
  configuration    SchoolPaymentConfiguration?    @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  payment          Payment?                       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  allocations      GatewayTransactionAllocation[]
  events           GatewayEvent[]
  refunds          GatewayRefund[]
  disputes         GatewayDispute[]
  dedicatedAccount DedicatedAccount?              @relation(fields: [dedicatedAccountId], references: [id], onDelete: SetNull)
  unapplied        UnappliedPayment?

  @@unique([provider, reference])
  @@index([schoolId, status, createdAt])
  @@index([studentId, createdAt])
  @@index([configurationId])
  @@index([providerTransactionId])
  @@index([dedicatedAccountId])
  @@index([status, nextVerificationAt])
}

/// Intended ledger allocations captured before leaving DigiSchool-Pro for checkout.
model GatewayTransactionAllocation {
  id                   String   @id @default(uuid())
  gatewayTransactionId String
  chargeId             String
  amount               Decimal  @db.Decimal(14, 2)
  createdAt            DateTime @default(now())

  gatewayTransaction GatewayTransaction @relation(fields: [gatewayTransactionId], references: [id], onDelete: Cascade)
  charge             StudentCharge      @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([gatewayTransactionId, chargeId])
  @@index([chargeId])
}

/// Durable webhook inbox. Persist a verified event before returning HTTP 200, then process
/// it through the idempotent gateway confirmation service.
model GatewayEvent {
  id                   String                    @id @default(uuid())
  schoolId             String?
  gatewayTransactionId String?
  provider             PaymentGatewayProvider    @default(PAYSTACK)
  environment          PaymentGatewayEnvironment
  providerEventId      String?
  eventType            String
  reference            String?
  payloadHash          String                    @db.Char(64)
  payload              Json?
  status               GatewayEventStatus        @default(PENDING)
  attempts             Int                       @default(0)
  nextAttemptAt        DateTime?
  claimedAt            DateTime?
  processedAt          DateTime?
  lastError            String?                   @db.Text
  receivedAt           DateTime                  @default(now())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  school             School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  gatewayTransaction GatewayTransaction? @relation(fields: [gatewayTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, payloadHash])
  @@unique([provider, environment, providerEventId])
  @@index([status, nextAttemptAt, receivedAt])
  @@index([reference])
  @@index([schoolId, receivedAt])
  @@index([gatewayTransactionId])
}

/// A provider refund is asynchronous. The finance ledger is reversed only after a
/// verified refund.processed event, never when the API first accepts the request.
model GatewayRefund {
  id                   String                    @id @default(uuid())
  schoolId             String
  gatewayTransactionId String
  /// The receipt reversed when the refund is processed. Null for a refund of held money.
  paymentId            String?
  /// Set when the refund returns held dedicated-account money rather than a receipt.
  unappliedPaymentId   String?                   @unique
  provider             PaymentGatewayProvider    @default(PAYSTACK)
  environment          PaymentGatewayEnvironment
  providerRefundId     String?
  status               GatewayRefundStatus       @default(REQUESTED)
  amount               Decimal                   @db.Decimal(14, 2)
  currency             String                    @default("NGN") @db.VarChar(3)
  reason               String                    @db.VarChar(500)
  requestedBy          String
  /// Two-person rule: a refund is sent to Paystack only after a different user approves it.
  approvedBy           String?
  approvedAt           DateTime?
  rejectedBy           String?
  rejectedAt           DateTime?
  rejectionReason      String?                   @db.VarChar(500)
  providerMessage      String?                   @db.Text
  expectedAt           DateTime?
  processedAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gatewayTransaction GatewayTransaction @relation(fields: [gatewayTransactionId], references: [id], onDelete: Restrict)
  payment            Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  unappliedPayment   UnappliedPayment?  @relation(fields: [unappliedPaymentId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, providerRefundId])
  @@index([gatewayTransactionId])
  @@index([schoolId, status, createdAt])
  @@index([paymentId])
}

/// Operational dispute record populated by charge.dispute.* events. Evidence and
/// resolution are intentional finance operations and are never inferred from a charge.
model GatewayDispute {
  id                   String                    @id @default(uuid())
  schoolId             String
  gatewayTransactionId String?
  provider             PaymentGatewayProvider    @default(PAYSTACK)
  environment          PaymentGatewayEnvironment
  providerDisputeId    String
  status               String                    @db.VarChar(64)
  amount               Decimal?                  @db.Decimal(14, 2)
  currency             String?                   @db.VarChar(3)
  reason               String?                   @db.VarChar(500)
  category             String?                   @db.VarChar(120)
  dueAt                DateTime?
  resolution           String?                   @db.VarChar(64)
  evidenceNote         String?                   @db.Text
  lastEventType        String                    @db.VarChar(100)
  lastEventAt          DateTime                  @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gatewayTransaction GatewayTransaction? @relation(fields: [gatewayTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, providerDisputeId])
  @@index([schoolId, status, dueAt])
  @@index([gatewayTransactionId])
}

/// Provider settlement summary imported for reconciliation. Monetary values are stored
/// in naira Decimal while provider payloads remain kobo at the adapter boundary.
model GatewaySettlement {
  id                   String                    @id @default(uuid())
  schoolId             String
  configurationId      String?
  provider             PaymentGatewayProvider    @default(PAYSTACK)
  environment          PaymentGatewayEnvironment
  providerSettlementId String
  status               String                    @db.VarChar(64)
  currency             String                    @default("NGN") @db.VarChar(3)
  totalAmount          Decimal                   @default(0) @db.Decimal(14, 2)
  totalFees            Decimal                   @default(0) @db.Decimal(14, 2)
  totalProcessed       Decimal                   @default(0) @db.Decimal(14, 2)
  settlementDate       DateTime?
  importedAt           DateTime                  @default(now())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  school School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues GatewayReconciliationIssue[]

  @@unique([provider, environment, providerSettlementId])
  @@index([schoolId, settlementDate])
  @@index([configurationId])
}

/// An append-only exception queue. Reconciliation reports differences; it never edits
/// a receipt or charge balance to make provider and ledger totals agree.
model GatewayReconciliationIssue {
  id                   String                           @id @default(uuid())
  schoolId             String
  settlementId         String?
  gatewayTransactionId String?
  dedupeKey            String                           @unique @db.VarChar(191)
  kind                 String                           @db.VarChar(64)
  status               GatewayReconciliationIssueStatus @default(OPEN)
  severity             String                           @default("WARNING") @db.VarChar(32)
  message              String                           @db.Text
  detail               Json?
  firstSeenAt          DateTime                         @default(now())
  lastSeenAt           DateTime                         @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  settlement GatewaySettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, lastSeenAt])
  @@index([gatewayTransactionId])
}

model Discount {
  id            String         @id @default(uuid())
  schoolId      String
  studentId     String
  sessionId     String
  termId        String?
  feeScheduleId String?
  chargeId      String?
  categoryId    String?
  type          AdjustmentType
  value         Decimal        @db.Decimal(12, 2)
  amountApplied Decimal        @default(0) @db.Decimal(12, 2)
  reason        String
  approvedBy    String?
  createdBy     String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student        @relation("StudentDiscounts", fields: [studentId], references: [id], onDelete: Cascade)
  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term        Term?          @relation(fields: [termId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule?   @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)
  charge      StudentCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  category    FeeCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([schoolId, isActive])
  @@index([studentId, isActive])
  @@index([sessionId])
  @@index([termId])
  @@index([chargeId])
}

model FeeExemption {
  id            String        @id @default(uuid())
  schoolId      String
  studentId     String
  sessionId     String
  termId        String?
  feeScheduleId String?
  chargeId      String?
  categoryId    String?
  type          ExemptionType
  value         Decimal?      @db.Decimal(12, 2)
  amountApplied Decimal       @default(0) @db.Decimal(12, 2)
  reason        String
  approvedBy    String?
  createdBy     String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student        @relation("StudentFeeExemptions", fields: [studentId], references: [id], onDelete: Cascade)
  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term        Term?          @relation(fields: [termId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule?   @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)
  charge      StudentCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  category    FeeCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([schoolId, isActive])
  @@index([studentId, isActive])
  @@index([sessionId])
  @@index([termId])
  @@index([chargeId])
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  classTermId String?
  termId      String?
  markedBy    String?
  date        DateTime
  status      AttendanceStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student   Student    @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Cascade)
  classTerm ClassTerm? @relation(fields: [classTermId], references: [id], onDelete: SetNull)
  term      Term?      @relation(fields: [termId], references: [id], onDelete: SetNull)
  marker    User?      @relation("AttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  // One row per student per day. Without this, two concurrent marks create two rows and
  // every attendance summary double-counts.
  @@unique([studentId, date])
  @@index([date])
  @@index([classTermId, date])
  @@index([termId, date])
  @@index([markedBy])
}

/// One term's rating for one affective or psychomotor trait.
///
/// Both domains were printed on the report card with hardcoded traits and a dash
/// for every rating; this is where the real figures live. The trait is stored as
/// a code from lib/report-traits.ts rather than as a label, so renaming what is
/// printed never orphans what was recorded.
model StudentTraitRating {
  id          String      @id @default(uuid())
  schoolId    String
  studentId   String
  termId      String
  classTermId String
  domain      TraitDomain
  /// Code from REPORT_TRAITS, e.g. PUNCTUALITY. Validated before it is written.
  trait       String
  /// 1 to 5, where 5 is Excellent. Enforced in the action, not by the column.
  rating      Int
  recordedBy  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student   @relation("StudentTraitRatings", fields: [studentId], references: [id], onDelete: Cascade)
  term           Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTerm      ClassTerm @relation(fields: [classTermId], references: [id], onDelete: Cascade)
  recordedByUser User      @relation("TraitRatingRecordedBy", fields: [recordedBy], references: [id])

  /// One rating per trait per term. Re-entering a trait updates the row rather
  /// than adding a second, so a report sheet can never show two values for one
  /// trait.
  @@unique([studentId, termId, trait])
  @@index([classTermId, termId])
  @@index([schoolId, termId])
}

// ---------------------------------------------------------------------------
// Expenditure
//
// The spending side of the ledger. Finance answers what came in; this answers where it
// went, and the two meet in the budget summary: paid income minus paid expenditure.
//
// Money is Decimal(12,2) here as it is in finance. Never Float.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  description String?
  /// A soft ceiling per term, reported against but never enforced. A school that has to fix
  /// a burst pipe should not be blocked by a stationery budget; the report says it went over.
  budgetLimit Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// Where money is paid from - the payment chart. Cash office, bank account, POS, petty cash.
model PaymentAccount {
  id             String             @id @default(uuid())
  schoolId       String
  name           String
  type           PaymentAccountType @default(CASH)
  bankName       String?
  accountNumber  String?
  /// What the account held when it was first entered. Its running balance is this minus
  /// everything paid out of it, computed on read rather than stored, so a corrected or
  /// cancelled expense cannot leave a stale balance behind.
  openingBalance Decimal            @default(0) @db.Decimal(12, 2)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  salaryPayments SalaryPayment[]
  staffConfigs   StaffConfig[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@index([type])
}

model Expense {
  id         String @id @default(uuid())
  schoolId   String
  sessionId  String
  /// Required, because every expenditure report is termly. Spending in a vacation belongs to
  /// the term it sits against in the school's own accounts.
  termId     String
  categoryId String
  accountId  String
  voucherNo  String

  payeeName      String
  payeeType      PayeeType @default(VENDOR)
  /// Set when the payee is a member of staff, so payroll and expenditure can be reconciled.
  payeeUserId    String?
  /// Set when the payee is a student - a fee refund, or a bursary paid out.
  payeeStudentId String?
  /// Set when the payee is a member of staff. Preferred over payeeUserId for HR, because a
  /// cleaner or driver has a Staff record but no login.
  payeeStaffId   String?

  description   String        @db.Text
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  referenceNo   String?
  expenseDate   DateTime
  notes         String?       @db.Text

  status ExpenseStatus @default(PENDING_APPROVAL)

  /// Segregation of duties: who wrote it up, who allowed it, who released the money. All
  /// three are kept even after the person leaves, which is why they are SetNull and not
  /// Cascade - deleting a user must not erase who approved a payment.
  recordedBy     String
  approvedBy     String?
  approvedAt     DateTime?
  paidBy         String?
  paidAt         DateTime?
  /// Why it was rejected or cancelled. The actions require one for both.
  decisionReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session        Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term           Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)
  category       ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account        PaymentAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recordedByUser User                 @relation("ExpenseRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
  approvedByUser User?                @relation("ExpenseApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  paidByUser     User?                @relation("ExpensePaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  payeeUser      User?                @relation("ExpensePayeeUser", fields: [payeeUserId], references: [id], onDelete: SetNull)
  payeeStudent   Student?             @relation("ExpensePayeeStudent", fields: [payeeStudentId], references: [id], onDelete: SetNull)
  payeeStaff     Staff?               @relation("ExpensePayeeStaff", fields: [payeeStaffId], references: [id], onDelete: SetNull)
  attachments    ExpenseAttachment[]
  salaryPayments SalaryPayment[]
  reversals      AccountingReversal[]

  /// Voucher numbers are issued per school, so two schools may both hold voucher 0001.
  @@unique([schoolId, voucherNo])
  @@index([schoolId, status])
  @@index([sessionId, status])
  @@index([termId, status])
  @@index([categoryId, status])
  @@index([accountId, status])
  @@index([expenseDate])
  @@index([recordedBy])
  @@index([approvedBy])
  @@index([paidBy])
  @@index([payeeUserId])
  @@index([payeeStudentId])
  @@index([payeeStaffId])
}

/// A scanned receipt or invoice backing an expense. Object storage holds the file; this
/// holds where it is and who put it there.
model ExpenseAttachment {
  id         String   @id @default(uuid())
  expenseId  String
  url        String   @db.VarChar(1000)
  fileName   String
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  createdAt  DateTime @default(now())

  expense        Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedByUser User    @relation("ExpenseAttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([expenseId])
}

/// Voucher numbering, per school per year. Mirrors ReceiptSequence on the income side.
model ExpenseVoucherSequence {
  id           String   @id @default(uuid())
  schoolId     String
  year         Int
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
  @@index([schoolId, year])
}

// ---------------------------------------------------------------------------
// HR and payroll
//
// Answers who works here, what each of them is owed, and whether it has been paid.
// Paying a payroll run creates an Expense, so salaries appear in the budget summary
// like any other spending.
//
// Money is Decimal(12,2) throughout, as in finance and expenditure. Never Float.
// ---------------------------------------------------------------------------

/// A person the school employs — teaching or not.
model Staff {
  id       String  @id @default(uuid())
  schoolId String
  staffNo  String
  /// Set when the staff member has a login. A teacher or an accountant is one person with
  /// one payslip, so their Staff record hangs off the same User rather than duplicating them.
  /// A cleaner or a driver has no login and no userId, which is why this is optional.
  userId   String? @unique

  firstName   String
  lastName    String
  gender      Gender?
  dateOfBirth DateTime?
  phone       String?
  email       String?
  address     String?   @db.Text

  department       String?
  jobTitle         String?
  staffType        StaffType        @default(OTHER)
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  dateEmployed     DateTime
  /// Set when they resign or are terminated. Payroll stops including them from this date.
  dateExited       DateTime?
  qualification    String?

  emergencyContactName  String?
  emergencyContactPhone String?

  /// Where salary is sent. Kept on the staff record rather than typed per payroll run.
  bankName      String?
  accountNumber String?
  accountName   String?
  pensionPfa    String?
  pensionPin    String?
  taxId         String?

  notes String? @db.Text

  /// How far through HR paperwork this person is.
  ///
  /// Defaults to COMPLETE, which is correct for every record that reaches this table the
  /// old way: an HR officer filling the staff form has the person in front of them. Only
  /// `provisionStaffForTeacher` writes NOT_STARTED, because a record created as a
  /// side-effect of adding a teacher has a name and almost nothing else. That default is
  /// also what keeps existing rows honest when this column is added.
  onboardingStatus StaffOnboardingStatus @default(COMPLETE)
  /// Set when the record was created automatically from a teacher rather than typed by HR.
  /// Kept so the onboarding queue can explain itself rather than just listing names.
  autoProvisioned  Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents    StaffDocument[]
  salaries     StaffSalary[]
  allowances   StaffAllowance[]
  deductions   StaffDeduction[]
  payrollItems PayrollItem[]
  discipline   StaffDisciplinaryRecord[]
  expenses     Expense[]                 @relation("ExpensePayeeStaff")

  @@unique([schoolId, staffNo])
  @@index([schoolId, employmentStatus])
  @@index([schoolId, onboardingStatus])
  @@index([schoolId, staffType])
  @@index([department])
  @@index([lastName, firstName])
}

/// Per-school HR settings, so payroll behaviour is the school's choice rather than ours.
model StaffConfig {
  id       String @id @default(uuid())
  schoolId String @unique

  /// Prefix for generated staff numbers, e.g. STF -> STF-0001.
  staffNoPrefix          String        @default("STF")
  /// Day of the month payroll is normally closed and run. Advisory; nothing enforces it.
  payrollClosingDay      Int           @default(25)
  /// Which account salaries are paid from by default.
  defaultAccountId       String?
  defaultPaymentMethod   PaymentMethod @default(BANK_TRANSFER)
  /// When false, a generated payroll can be paid without a separate approval step. Small
  /// schools where the admin does everything can turn the ceremony off.
  requirePayrollApproval Boolean       @default(true)
  /// When false, payroll generation refuses to produce an item whose deductions exceed pay.
  /// Off by default: a negative payslip is almost always a misconfigured deduction.
  allowNegativeNet       Boolean       @default(false)
  /// Pay a staff member joining mid-month for the days they actually worked.
  prorateFirstMonth      Boolean       @default(true)
  /// Free text printed at the foot of every payslip.
  payslipNote            String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  defaultAccount PaymentAccount? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
}

/// A standard salary level: Grade Level 1, Senior Teacher, Principal.
model SalaryScale {
  id          String  @id @default(uuid())
  schoolId    String
  name        String
  gradeLevel  String?
  step        String?
  baseSalary  Decimal @db.Decimal(12, 2)
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  salaries StaffSalary[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// One staff member's salary, valid from a date.
///
/// Never updated in place. A raise inserts a new row and deactivates the old one, so the
/// history of what someone was paid, and who approved it, survives.
model StaffSalary {
  id      String  @id @default(uuid())
  staffId String
  scaleId String?

  baseSalary    Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  isActive      Boolean  @default(true)

  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  scale          SalaryScale? @relation(fields: [scaleId], references: [id], onDelete: SetNull)
  createdByUser  User         @relation("StaffSalaryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedByUser User?        @relation("StaffSalaryApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([staffId, isActive])
  @@index([staffId, effectiveFrom])
  @@index([scaleId])
}

/// A kind of allowance the school pays: transport, housing, responsibility.
model AllowanceType {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  kind        ComponentKind @default(FIXED)
  /// Naira when FIXED; a percentage of base salary when PERCENTAGE.
  value       Decimal       @db.Decimal(12, 2)
  isTaxable   Boolean       @default(true)
  isRecurring Boolean       @default(true)
  isActive    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments StaffAllowance[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// A kind of deduction: PAYE, pension, union dues, a loan repayment.
model DeductionType {
  id          String          @id @default(uuid())
  schoolId    String
  name        String
  kind        ComponentKind   @default(FIXED)
  value       Decimal         @db.Decimal(12, 2)
  /// PRE_TAX deductions come off before a percentage tax is worked out; POST_TAX after.
  timing      DeductionTiming @default(POST_TAX)
  isRecurring Boolean         @default(true)
  isActive    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments StaffDeduction[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// An allowance attached to one staff member, recurring or for a single month.
model StaffAllowance {
  id              String @id @default(uuid())
  staffId         String
  allowanceTypeId String

  /// Overrides the type's value for this person. Null means use the type's value.
  valueOverride Decimal?  @db.Decimal(12, 2)
  isRecurring   Boolean   @default(true)
  /// Set on a one-off, so it lands in exactly one payroll run.
  periodYear    Int?
  periodMonth   Int?
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  reason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff         Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  allowanceType AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)

  @@index([staffId, isActive])
  @@index([allowanceTypeId])
  @@index([periodYear, periodMonth])
}

/// A deduction attached to one staff member, recurring or for a single month.
model StaffDeduction {
  id              String @id @default(uuid())
  staffId         String
  deductionTypeId String

  valueOverride Decimal?  @db.Decimal(12, 2)
  isRecurring   Boolean   @default(true)
  periodYear    Int?
  periodMonth   Int?
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  reason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff         Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  deductionType DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Restrict)

  @@index([staffId, isActive])
  @@index([deductionTypeId])
  @@index([periodYear, periodMonth])
}

/// One month's payroll for a school.
model PayrollRun {
  id        String  @id @default(uuid())
  schoolId  String
  sessionId String?
  year      Int
  month     Int

  status PayrollStatus @default(DRAFT)

  totalBase       Decimal @default(0) @db.Decimal(14, 2)
  totalAllowances Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalGross      Decimal @default(0) @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @db.Decimal(14, 2)

  generatedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  paidBy         String?
  paidAt         DateTime?
  /// Why it was cancelled, or a note left at approval.
  decisionReason String?   @db.VarChar(500)
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session         Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  generatedByUser User                 @relation("PayrollGeneratedBy", fields: [generatedBy], references: [id], onDelete: Restrict)
  approvedByUser  User?                @relation("PayrollApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  paidByUser      User?                @relation("PayrollPaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  items           PayrollItem[]
  payments        SalaryPayment[]
  reversals       AccountingReversal[]

  /// One payroll per school per month. This is the duplicate-payroll guard, at the database
  /// level rather than only in application code.
  @@unique([schoolId, year, month])
  @@index([schoolId, status])
  @@index([sessionId])
  @@index([year, month])
}

/// Append-only accounting evidence for money that was returned or a payment that was
/// undone. The original record stays visible and immutable; exactly one target is set.
model AccountingReversal {
  id           String         @id @default(uuid())
  schoolId     String
  targetType   ReversalTarget
  paymentId    String?        @unique
  expenseId    String?        @unique
  payrollRunId String?        @unique
  amount       Decimal        @db.Decimal(14, 2)
  reason       String         @db.VarChar(500)
  referenceNo  String?
  reversedAt   DateTime       @default(now())
  // Null when the provider reversed the money rather than a person: an upheld chargeback
  // has no author at this school, and naming one would put a staff member's id against a
  // decision they did not make.
  createdBy    String?
  createdAt    DateTime       @default(now())

  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment       Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense       Expense?    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  createdByUser User?       @relation("AccountingReversalCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([schoolId, reversedAt])
  @@index([targetType, reversedAt])
}

/// One staff member's line in a payroll run.
model PayrollItem {
  id       String @id @default(uuid())
  schoolId String
  runId    String
  staffId  String

  payslipNo String

  baseSalary      Decimal @db.Decimal(12, 2)
  totalAllowances Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  grossPay        Decimal @db.Decimal(12, 2)
  netPay          Decimal @db.Decimal(12, 2)

  /// Set when the staff member joined or left mid-month and the pay was prorated.
  proratedDays Int?
  daysInMonth  Int?

  status PayrollItemStatus @default(PENDING)
  paidAt DateTime?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  run      PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  staff    Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  lines    PayrollItemLine[]
  payments SalaryPayment[]

  /// One line per staff member per run, so a regenerate cannot pay someone twice.
  @@unique([runId, staffId])
  @@unique([schoolId, payslipNo])
  @@index([staffId, status])
  @@index([runId, status])
}

/// The frozen breakdown behind a payslip.
///
/// The reason this table exists: a payslip must reprint identically for years. If the
/// figures were recomputed from AllowanceType and DeductionType on demand, then editing a
/// transport allowance today would silently rewrite every payslip ever issued. So the
/// computed amount and the label are copied here when the run is generated, and nothing
/// downstream reads the live configuration again.
model PayrollItemLine {
  id     String @id @default(uuid())
  itemId String

  kind   PayrollLineKind
  label  String
  amount Decimal         @db.Decimal(12, 2)

  /// Which configuration row produced this line, for tracing. Deliberately not a foreign
  /// key: the type may later be deleted, and the payslip must survive that.
  sourceType String?
  sourceId   String?
  isTaxable  Boolean?
  timing     DeductionTiming?

  createdAt DateTime @default(now())

  item PayrollItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, kind])
}

/// Money actually leaving the school for salaries.
///
/// `itemId` is null for a single payment covering the whole run, which is the usual case,
/// and set when one staff member is paid separately.
model SalaryPayment {
  id       String  @id @default(uuid())
  schoolId String
  runId    String
  itemId   String?

  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  accountId String?
  reference String?
  paidAt    DateTime
  paidBy    String
  /// The expenditure record this payment created, so salaries appear in the budget summary
  /// alongside every other kind of spending.
  expenseId String?

  createdAt DateTime @default(now())

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  run        PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  item       PayrollItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  account    PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  paidByUser User            @relation("SalaryPaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  expense    Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([schoolId, paidAt])
  @@index([runId])
  @@index([itemId])
  @@index([expenseId])
}

/// Payslip numbering, per school per year. Mirrors receipts and vouchers.
model PayslipSequence {
  id           String   @id @default(uuid())
  schoolId     String
  year         Int
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
}

/// Queries, warnings, suspensions and exits. Kept out of payroll but on the staff record.
model StaffDisciplinaryRecord {
  id      String @id @default(uuid())
  staffId String

  type          DisciplinaryType
  reason        String           @db.Text
  occurredOn    DateTime
  actionTaken   String?          @db.Text
  attachmentUrl String?          @db.VarChar(1000)

  recordedBy String
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  recordedByUser User  @relation("DisciplineRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
  approvedByUser User? @relation("DisciplineApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([staffId, occurredOn])
  @@index([type])
}

/// Per-school rules for promoting students at the end of a term.
///
/// Two switches, independent on purpose: a school may want to insist results are published
/// before anyone moves up, or apply an academic bar, or both, or neither. Both default to
/// off so enabling the feature is a deliberate act rather than something that silently
/// changes how an existing school works.
model TransitionPolicy {
  id       String @id @default(uuid())
  schoolId String @unique

  /// Refuse to promote out of a term whose results are not finished and released.
  requireResultsPublished   Boolean                  @default(false)
  /// Refuse to promote a student who missed the academic bar below.
  usePromotionCriteria      Boolean                  @default(false)
  /// Minimum overall average out of 100. Null means the average is not tested.
  promotionMinAverage       Decimal?                 @db.Decimal(5, 2)
  /// Minimum subjects at or above the grading system's pass mark. Null means untested.
  minSubjectsPassed         Int?
  /// TERM uses the selected term only; SESSION_AVERAGE evaluates all published terms in
  /// the same academic session where available.
  evaluationScope           PromotionEvaluationScope @default(TERM)
  /// Subject ids that must be passed. JSON keeps this flexible without hardcoding core
  /// subjects globally across schools.
  requiredSubjectIds        Json?
  minCoreSubjectsPassed     Int?
  requireAllSubjectsEntered Boolean                  @default(false)
  allowManualOverride       Boolean                  @default(true)
  /// Minimum subjects at or above `creditMark`. Null means credits are not counted.
  ///
  /// Distinct from `minSubjectsPassed`, which counts against the grading system pass mark
  /// (40 by default). A credit is the higher bar Nigerian schools actually promote on: a
  /// D7 at 45 is a pass and is not a credit.
  minCreditsRequired        Int?
  /// The score a subject must reach to count as a credit. 50 is the WAEC C6 boundary.
  creditMark                Decimal                  @default(50.00) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A class's own promotion rules, overriding the school default.
///
/// The school-wide `TransitionPolicy` answers "how does this school promote"; this answers
/// "except for JSS3", which is the question a real school actually has. A class with no row
/// here follows the school default unchanged, so adding this model changes nothing until
/// somebody deliberately overrides a class.
///
/// Deliberately **not** versioned by session. A policy edit cannot rewrite history because
/// history does not read the policy: `AnnualResultDecision` freezes the rule it was judged
/// by at the moment the decision is taken.
model ClassPromotionPolicy {
  id       String @id @default(uuid())
  schoolId String
  classId  String @unique

  requireResultsPublished   Boolean                  @default(false)
  usePromotionCriteria      Boolean                  @default(true)
  promotionMinAverage       Decimal?                 @db.Decimal(5, 2)
  minSubjectsPassed         Int?
  minCreditsRequired        Int?
  creditMark                Decimal                  @default(50.00) @db.Decimal(5, 2)
  evaluationScope           PromotionEvaluationScope @default(SESSION_AVERAGE)
  requiredSubjectIds        Json?
  minCoreSubjectsPassed     Int?
  requireAllSubjectsEntered Boolean                  @default(false)
  allowManualOverride       Boolean                  @default(true)
  /// A final year - SS3, or Primary 6. Its learners GRADUATE rather than being PROMOTED.
  /// The academic bar still applies: a school that wants every finalist out regardless
  /// turns `usePromotionCriteria` off for the class rather than needing a second flag.
  isGraduatingClass         Boolean                  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// One learner's end-of-session outcome, frozen.
///
/// This is the record the annual report card prints, and the reason the promotion rules
/// needed somewhere to land. Three things matter about it:
///
///  - **The decision is a field, not a sentence.** `decision` is the status; the principal's
///    words are separate free text. Parsing "Promoted to JSS2" back into a status would be
///    a bug waiting to happen.
///  - **It is a snapshot.** The average, the counts, the reasons and the policy that judged
///    them are all copied in. Editing a class's promotion rule next year must not silently
///    restate what was decided this year.
///  - **Deciding and approving are separate acts.** An exams officer computes; a principal
///    approves. Only an approved decision prints on a card.
model AnnualResultDecision {
  id        String @id @default(uuid())
  schoolId  String
  sessionId String
  classId   String
  studentId String

  decision         AnnualPromotionDecision @default(PENDING)
  /// The principal's own words. Never the status - see the note above.
  principalComment String?                 @db.Text

  sessionAverage  Decimal? @db.Decimal(5, 2)
  subjectsOffered Int      @default(0)
  subjectsPassed  Int      @default(0)
  creditsEarned   Int      @default(0)
  termsCounted    Int      @default(0)

  /// The resolved policy this was judged by, copied in rather than referenced.
  policyBasis Json?
  /// Every reason the policy gave for refusing, frozen with the decision.
  reasons     Json?

  /// True when a human chose an outcome the rules did not reach.
  isOverride     Boolean @default(false)
  overrideReason String? @db.Text

  /// User ids, deliberately without relations: who decided must survive their account
  /// being deleted, the same reasoning as `Assessment.publishedBy`.
  decidedBy  String?
  decidedAt  DateTime?
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([schoolId, sessionId])
  @@index([classId, sessionId])
  @@index([sessionId, decision])
}

/// A file HR holds for a staff member: the appointment letter, an ID, a certificate.
///
/// The file itself lives in the same storage the expenditure receipts use; this row is the
/// record of it, plus the two things a paper file cannot answer - when it expires and who
/// checked it.
model StaffDocument {
  id      String            @id @default(uuid())
  staffId String
  type    StaffDocumentType
  title   String

  /// Storage key, not a URL. Resolved through the same signing path as expense receipts so
  /// a staff member's ID card is never a guessable public link.
  storageKey String
  fileName   String?
  fileSize   Int?
  mimeType   String?

  /// For anything that lapses - a contract, a work permit, a medical.
  expiresAt DateTime?

  /// User ids without relations, for the same reason as AnnualResultDecision.
  uploadedBy String?
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, type])
  @@index([expiresAt])
}

/// One message, queued rather than sent inline.
///
/// cPanel has no persistent worker, so nothing can sit in memory waiting to send - and the
/// outbox is the better shape anyway. A bursar pressing "send reminders" for four hundred
/// families must not hold their browser open for four hundred provider round trips, and
/// when it fails halfway there has to be a record of exactly who was reached.
///
/// `dedupeKey` is what makes a retry safe. Publishing a class's results twice, or a cron
/// overlapping itself, must not text every family twice; the unique constraint on
/// (schoolId, dedupeKey) turns the second attempt into a no-op at the database rather than
/// relying on the caller to remember.
model NotificationOutbox {
  id       String @id @default(uuid())
  schoolId String

  channel         NotificationChannel
  /// A phone number in +234 form, or an email address. One column because `channel` says
  /// which it is, and a message only ever has one destination.
  recipient       String
  recipientUserId String?
  /// Who the message is about, so a school can answer "what did we send about this child".
  studentId       String?

  /// Email only; null on a text.
  subject     String?
  body        String  @db.Text
  templateKey String?

  /// Null means "this message is allowed to repeat" - a manual one-off, say.
  dedupeKey String?

  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  maxAttempts Int                @default(3)

  provider          String?
  providerMessageId String?
  lastError         String? @db.Text

  /// Segments for a text, always 1 for an email. Frozen at queue time so a school can
  /// reconcile a provider bill against what it actually asked for.
  units Int @default(1)

  queuedAt    DateTime  @default(now())
  /// Not before this. A failed attempt pushes it forward so retries back off instead of
  /// hammering a provider that is already refusing.
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  /// User id without a relation: who caused a message to be sent must survive that member
  /// of staff being deleted, the same reasoning as `Assessment.publishedBy`.
  triggeredBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dedupeKey])
  /// The worker's query: what is due to go out, oldest first.
  @@index([status, availableAt])
  @@index([schoolId, channel, status])
  @@index([studentId])
  @@index([queuedAt])
}

/// A school's own wording for a kind of message.
///
/// Wording is data, not code: a school says "Dear Parent" or "Good day" in its own voice,
/// and neither belongs in a deployment. A school with no row here falls back to the
/// built-in default in `lib/notifications/templates.ts`, so notifications work before
/// anybody has configured anything.
model NotificationTemplate {
  id       String @id @default(uuid())
  schoolId String

  /// Which trigger this wording is for - `results.published` and so on.
  templateKey String
  channel     NotificationChannel

  /// Email only.
  subject  String?
  body     String  @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, templateKey, channel])
  @@index([schoolId, isActive])
}

