/// Slice 9: a student's permanent Paystack account number. Money transferred into it can
/// belong to that student only, so it is allocated without asking anyone to choose.
model DedicatedAccount {
  id                   String                    @id @default(uuid())
  schoolId             String
  studentId            String
  configurationId      String
  provider             PaymentGatewayProvider    @default(PAYSTACK)
  environment          PaymentGatewayEnvironment
  status               DedicatedAccountStatus    @default(ACTIVE)
  providerCustomerCode String                    @db.VarChar(64)
  providerAccountId    String                    @db.VarChar(64)
  /// Synthetic per-student address; Paystack keys customers by email.
  customerEmail        String                    @db.VarChar(320)
  accountNumber        String                    @db.VarChar(10)
  accountName          String                    @db.VarChar(191)
  bankName             String                    @db.VarChar(120)
  bankSlug             String?                   @db.VarChar(64)
  createdBy            String
  deactivatedAt        DateTime?
  deactivatedBy        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  configuration SchoolPaymentConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  transactions  GatewayTransaction[]

  @@unique([provider, environment, accountNumber])
  @@unique([provider, environment, providerAccountId])
  @@index([provider, environment, providerCustomerCode])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([configurationId])
}

/// Money a dedicated-account transfer brought in beyond what the student owed. It is held
/// here for the bursar to apply or return; it is never forced onto a charge silently.
model UnappliedPayment {
  id                   String                 @id @default(uuid())
  schoolId             String
  studentId            String
  gatewayTransactionId String                 @unique
  amount               Decimal                @db.Decimal(14, 2)
  status               UnappliedPaymentStatus @default(OPEN)
  appliedPaymentId     String?
  resolvedBy           String?
  resolvedAt           DateTime?
  resolutionNote       String?                @db.VarChar(500)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  gatewayTransaction GatewayTransaction @relation(fields: [gatewayTransactionId], references: [id], onDelete: Restrict)
  appliedPayment     Payment?           @relation(fields: [appliedPaymentId], references: [id], onDelete: SetNull)
  refund             GatewayRefund?

  @@index([schoolId, status, createdAt])
  @@index([studentId])
  @@index([appliedPaymentId])
}

enum DedicatedAccountStatus {
  ACTIVE
  DEACTIVATED
}

enum GatewayTransactionSource {
