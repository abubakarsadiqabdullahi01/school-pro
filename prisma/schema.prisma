/// Paystack customer identification (BVN + bank account) for a student's dedicated account,
/// when Paystack requires it. The BVN and account number are sent to Paystack and never
/// stored here; Paystack answers asynchronously with customeridentification.success/failed.
model DedicatedCustomerIdentification {
  id              String                        @id @default(uuid())
  schoolId        String
  studentId       String
  configurationId String
  environment     PaymentGatewayEnvironment
  customerCode    String                        @db.VarChar(64)
  customerEmail   String                        @db.VarChar(320)
  status          DedicatedIdentificationStatus @default(PENDING)
  failureReason   String?                       @db.VarChar(500)
  requestedBy     String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  configuration SchoolPaymentConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)

  @@unique([configurationId, studentId])
  @@index([environment, customerCode])
  @@index([schoolId, status])
}

enum DedicatedIdentificationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A school's message to families or staff, sent by SMS and/or email. The send itself goes
/// through the notification outbox like every other message; this row is the record of
/// what was said, to whom, and when.
model Announcement {
  id          String                 @id @default(uuid())
  schoolId    String
  title       String                 @db.VarChar(150)
  message     String                 @db.Text
  audience    AnnouncementAudience
  /// Class ids when audience is CLASS_PARENTS.
  classIds    Json?
  /// ["SMS"], ["EMAIL"] or both.
  channels    Json
  status      AnnouncementStatus     @default(DRAFT)
  /// Messages are held in the outbox until this time; null sends at once.
  scheduledFor DateTime?
  queuedCount Int                    @default(0)
  createdBy   String
  sentAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

enum AnnouncementAudience {
  ALL_PARENTS
  CLASS_PARENTS
  STAFF
}

enum AnnouncementStatus {
  DRAFT
  QUEUED
  CANCELLED
}

/// A school's own controls over what the platform sends on its behalf.
model SchoolNotificationSettings {
  id              String   @id @default(uuid())
  schoolId        String   @unique
  /// "templateKey:CHANNEL" pairs the school has switched off, e.g. "fees.reminder:SMS".
  disabled        Json?
  /// SMS units (segments) the school allows per calendar month; null means no cap.
  smsMonthlyLimit Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}
