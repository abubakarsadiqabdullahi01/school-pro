# ---------------------------------------------------------------------------
# school-pro — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MySQL connection string used by Prisma (prisma/schema.prisma). The project moved off
# PostgreSQL; the old migrations are kept in prisma/_archive/postgres-migrations.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/school_pro"

# Initial super admin setup only. Remove both passwords after setup.
# Creates superadmin@schoolpro.ng and admin@schoolpro.ng.
SUPER_ADMIN_PASSWORD=""
SECOND_SUPER_ADMIN_PASSWORD=""

# --- Auth (NextAuth v5) -----------------------------------------------------
# Validated by lib/env-validation.ts, which requires the NEXTAUTH_* names.
# Must be at least 32 characters in production.
# Generate one with:  npx auth secret     (or)  openssl rand -base64 32
NEXTAUTH_SECRET=""
# Canonical origin of the deployment; no trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# Set true behind the trusted cPanel reverse proxy.
AUTH_TRUST_HOST="true"

# --- Paystack (test development) -------------------------------------------
# Use newly generated values from the Paystack dashboard. Never commit a filled-in file.
# The secret key is server-only and must never use a NEXT_PUBLIC_ prefix.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_ENV="test"
PAYSTACK_WEBHOOK_URL="http://localhost:3000/api/webhooks/paystack"
PAYSTACK_TIMEOUT_MS="10000"
# 32 random bytes encoded as base64. Required only for school-owned gateway credentials.
PAYMENT_GATEWAY_ENCRYPTION_KEY=""
PAYMENT_CHECKOUT_ENV="TEST"
PAYMENT_CRON_SECRET=""
# Slice 9 dedicated accounts: domain for the per-student Paystack customer emails. These
# addresses never receive mail; default is students.<NEXTAUTH_URL host>.
PAYSTACK_DVA_EMAIL_DOMAIN=""
# Optional defence-in-depth when your trusted proxy supplies the real client IP.
PAYSTACK_WEBHOOK_ENFORCE_IP="false"

# --- SmartSMSSolutions notifications ---------------------------------------
# Generate a fresh API-x token after revoking any token exposed in screenshots/logs.
# The same deployment token supports SMS and transactional email. Never commit it.
SMARTSMS_API_TOKEN=""
# Approved/whitelisted sender identity, normally the school/platform brand (max provider rules apply).
SMARTSMS_SENDER_ID=""
# 3 = basic route, with DND numbers sent through the corporate route.
SMARTSMS_SMS_ROUTING="3"
# Created once in SmartSMS Email > Webhooks and shown only once. Minimum 16 characters.
SMARTSMS_EMAIL_WEBHOOK_SECRET=""

# Persistent uploads outside public_html and outside the app's release folder.
# Required in production. Leave empty for ./storage/uploads during development.
UPLOAD_DIR=""
# cPanel example: /home/digisof1/storage/digisoft-school-pro
# No AWS/S3 credentials are required for new uploads.
