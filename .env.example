# ---------------------------------------------------------------------------
# school-pro — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MySQL connection string used by Prisma (prisma/schema.prisma). The project moved off
# PostgreSQL; the old migrations are kept in prisma/_archive/postgres-migrations.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/school_pro"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Validated by lib/env-validation.ts, which requires the NEXTAUTH_* names.
# Must be at least 32 characters in production.
# Generate one with:  npx auth secret     (or)  openssl rand -base64 32
NEXTAUTH_SECRET=""
# Canonical origin of the deployment; no trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# --- Object storage (S3-compatible; see lib/S3Client.ts) --------------------
# All four are required — S3Client throws at startup if any is missing.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://t3.storage.dev"
AWS_REGION="auto"
# Bucket for avatars and school logos. NEXT_PUBLIC_ = exposed to the browser,
# so put only the bucket name here, never a credential.
NEXT_PUBLIC_S3_BUCKET_IMAGES=""
