# ---------------------------------------------------------------------------
# school-pro — production environment (cPanel / Passenger)
#
# Do NOT upload this file, or a filled-in copy of it, to the server. Enter these
# in cPanel > Setup Node.js App > Environment variables, which writes them into
# the Passenger process without leaving a readable file under the doc root.
#
# DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL and UPLOAD_DIR are enforced by
# lib/env-validation.ts on the first page render; the rest are read where noted.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# cPanel prefixes both the database and the user with your account name, so the
# real values look like  digisof1_schoolpro  /  digisof1_appuser.
# The socket host is localhost — the app and MySQL are on the same machine, and
# Remote Database Access is not needed for this.
# Special characters in the password must be percent-encoded in this URL.
DATABASE_URL="mysql://ACCOUNT_dbuser:PASSWORD@localhost:3306/ACCOUNT_dbname"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Must be at least 32 characters — lib/env-validation.ts throws below that in
# production. Generate with:  npx auth secret
NEXTAUTH_SECRET=""

# The public https origin, no trailing slash. Must match the domain exactly,
# including whether you use www — a mismatch breaks the session cookie.
NEXTAUTH_URL="https://schoolpro.digisoft.com.ng"

# REQUIRED ON cPANEL, and not needed locally. Passenger serves the app behind
# Apache/LiteSpeed as a reverse proxy, so the Host header does not match what
# NextAuth v5 computes on its own; without this it refuses the request with
# `UntrustedHost` and every sign-in fails. There is no code change needed —
# NextAuth reads this variable directly.
AUTH_TRUST_HOST="true"

# --- Paystack ---------------------------------------------------------------
# Enter these directly in cPanel environment variables. Use test values during the pilot
# build and replace them with newly generated live values only after live approval.
# PAYSTACK_SECRET_KEY is server-only; never prefix it with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_ENV="live"
# Must be on the same https origin as NEXTAUTH_URL. If they differ, the app refuses every
# Paystack webhook with 503 ("PAYSTACK_WEBHOOK_URL must use the configured application
# origin"), and payments are confirmed only by the process-events cron.
# No trailing slash, here or in the Paystack dashboard: the app redirects "/paystack/" to
# "/paystack", and Paystack does not follow redirects, so its webhooks would never arrive.
PAYSTACK_WEBHOOK_URL="https://schoolpro.digisoft.com.ng/api/webhooks/paystack"
PAYSTACK_TIMEOUT_MS="10000"
# 32 random bytes encoded as base64. Keep stable across releases and back it up securely.
PAYMENT_GATEWAY_ENCRYPTION_KEY=""
PAYMENT_CHECKOUT_ENV="LIVE"
PAYMENT_CRON_SECRET=""
# Enable only when the reverse proxy is trusted to overwrite forwarded IP headers.
PAYSTACK_WEBHOOK_ENFORCE_IP="false"

# --- SMS and email (SmartSMSSolutions) -------------------------------------
# Without these, nothing is sent: receipts, fee reminders, results notices and
# announcements stay QUEUED in the outbox, and /api/health reports
# "providersConfigured": false. One API token covers both SMS and email.
# Generate a fresh token for production; never reuse one that appeared in a screenshot.
SMARTSMS_API_TOKEN=""
# The approved sender ID registered with SmartSMS for the platform.
SMARTSMS_SENDER_ID=""
# 3 = basic route, with DND numbers sent through the corporate route.
SMARTSMS_SMS_ROUTING="3"
# Created once in SmartSMS > Email > Webhooks, pointed at
#   https://schoolpro.digisoft.com.ng/api/webhooks/smartsms/email
# It is shown only once. Minimum 16 characters.
SMARTSMS_EMAIL_WEBHOOK_SECRET=""
# Leave NOTIFICATIONS_ALLOW_LOG_DELIVERY unset in production. Set, it lets a channel with
# no real provider mark messages as sent, and a school would be told it notified parents
# when nothing left the building.

# --- Uploads ----------------------------------------------------------------
# Avatars, school logos and expenditure receipts are written to disk by
# lib/local-storage.ts. This MUST be an absolute path OUTSIDE the document root —
# anything under a web-served directory is downloadable by URL, and receipts are
# meant to be reachable only through /api/files/, which checks the viewer's
# school and permissions first. Create it once over SSH or File Manager:
#
#     mkdir -p /home/ACCOUNT/apps/school-pro-storage/uploads
#
# Keep it out of the application root too, so a re-upload of the bundle can never
# overwrite it. Back it up separately from the database — the database stores
# only the /api/files/... reference, not the bytes.
UPLOAD_DIR="/home/ACCOUNT/apps/school-pro-storage/uploads"

# --- First-run seeding (can be removed after the first login) ---------------
# deploy/seed-super-admin.mjs creates superadmin@schoolpro.ng and
# admin@schoolpro.ng. Passwords must be at least 8 characters; choose unique,
# longer passwords where possible. Delete both variables after setup.
SUPER_ADMIN_PASSWORD=""
SECOND_SUPER_ADMIN_PASSWORD=""

# --- Runtime ----------------------------------------------------------------
NODE_ENV="production"
# Leave PORT unset. Passenger assigns one and server.js reads it; hardcoding a
# port here makes the app bind somewhere Passenger is not listening.
