# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# Upload bundle produced by `npm run build:deploy` (see DEPLOYMENT.md).
/deploy/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database dumps written by scripts/backup-database.ts. Never commit these —
# they contain every student record in the system.
/backups/
/storage/
*.sql.gz

# Generated release archives and their split parts. A deploy bundle is ~82 MB
# and is rebuilt from the tagged source, so there is nothing to gain from
# versioning them; the directory currently holds 343 MB of them.
/outputs/

# Scratch space for one-off scripts. Nothing here is part of the app.
/tmp/

# JetBrains project files. workspace.xml carries per-developer window layout and
# recent-file history, so this is local state rather than project configuration.
.idea/
